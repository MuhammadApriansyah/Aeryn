#!/data/data/com.termux/files/usr/bin/sh
# V61.4 — IN2/IN3: Aeryn watchdog (runsvdir/termux-services).
# Monitor api/pg/redis + alert termux-notification + catat bitemporal facts.
export HOME=/data/data/com.termux/files/home
export PREFIX=/data/data/com.termux/files/usr
export PATH=$PREFIX/bin:$PATH
export AERYN_WATCHDOG_API_URL=http://127.0.0.1:3010/health
export AERYN_WATCHDOG_INTERVAL=60
cd $HOME/aeryn-core-agent
exec $HOME/aeryn-venv/bin/python aeryn_core/platform/watchdog.py
