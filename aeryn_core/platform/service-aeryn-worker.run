#!/data/data/com.termux/files/usr/bin/sh
# aeryn-worker service (runsvdir) — V62.13 log wrapper: output → log file rapi.
export HOME=/data/data/com.termux/files/home
export PREFIX=/data/data/com.termux/files/usr
export PATH=$PREFIX/bin:$PATH
export AERYN_DB=postgresql://sen@127.0.0.1:5432/aeryn
mkdir -p $PREFIX/var/log/aeryn
cd $HOME/aeryn-core-agent
exec sh -c '$HOME/aeryn-venv/bin/python aeryn_core/platform/queue_worker.py 2>&1 | stdbuf -oL tee -a $PREFIX/var/log/aeryn/aeryn-worker.log'
